    {
      "parameters": {
        "jsCode": "const cabecalhos = $(\"Extract from File3\").all().map(item => item.json);\nconst itens = $(\"Extract from File4\").all().map(item => item.json);\n\nconst documentosFormatados = [];\n\n// 1. Criar um mapa dos itens para busca rápida\nconst itensMap = new Map();\nfor (const item of itens) {\n  const idNota = item['CHAVE DE ACESSO']; \n  if (!itensMap.has(idNota)) {\n    itensMap.set(idNota, []);\n  }\n  itensMap.get(idNota).push(item);\n}\n\n$('Extract from File3').first().json['RAZÃO SOCIAL EMITENTE']\n// 2. Iterar sobre os cabeçalhos para criar um documento por NF\nfor (const cabecalho of cabecalhos) {\n  const idNota = cabecalho['CHAVE DE ACESSO'];\n  const itensDaNF = itensMap.get(idNota) || [];\n  \n  // Formatar o texto da NF completa (cabeçalho + itens)\n  const textoDaNFCompleta = `\n    Chave Nota Fiscal: ${idNota}\n    Numero: ${cabecalho['NÚMERO']}\n    Modelo: ${cabecalho['MODELO']}\n    Série: ${cabecalho['SÉRIE']}\n    Natureza da Operação: ${cabecalho['NATUREZA DA OPERAÇÃO']}\n    Data de Emissão: ${cabecalho['DATA EMISSÃO']}\n    Evento Mais Recente: ${cabecalho['EVENTO MAIS RECENTE']}\n    Data/Hora do Evento Mais Recente: ${cabecalho['DATA/HORA EVENTO MAIS RECENTE']}\n    CPF/CNPJ do Emitente: ${cabecalho['CPF/CNPJ Emitente']}\n    Razão Social do Emitente: ${cabecalho['RAZÃO SOCIAL EMITENTE']}\n    Inscrição Estadual do Emitente: ${cabecalho['INSCRIÇÃO ESTADUAL EMITENTE']}\n    UF do Emitente: ${cabecalho['UF EMITENTE']}\n    Município do Emitente: ${cabecalho['MUNICÍPIO EMITENTE']}\n    CNPJ do Destinatário: ${cabecalho['CNPJ DESTINATÁRIO']}\n    Nome do Destinatário: ${cabecalho['NOME DESTINATÁRIO']}\n    UF do Destinatário: ${cabecalho['UF DESTINATÁRIO']}\n    Indicador IE do Destinatário: ${cabecalho['INDICADOR IE DESTINATÁRIO']}\n    Destino da Operação: ${cabecalho['DESTINO DA OPERAÇÃO']}\n    Consumidor Final: ${cabecalho['CONSUMIDOR FINAL']}\n    Presença do Comprador: ${cabecalho['PRESENÇA DO COMPRADOR']}\n    Valor da Nota Fiscal: ${cabecalho['VALOR NOTA FISCAL']}\n    \n    Itens:\n    ${itensDaNF.map(it => `\n    - Item Número: ${it['NÚMERO PRODUTO']}\n      Descrição: ${it['DESCRIÇÃO DO PRODUTO/SERVIÇO']}\n      Codigo NCM/SH: ${it['CÓDIGO NCM/SH']}\n      Tipo de Produto: ${it['NCM/SH (TIPO DE PRODUTO)']}\n      CFOP: ${it['CFOP']}\n      Quantidade: ${it['QUANTIDADE']} ${it['UNIDADE']}\n      Valor Unitário: R$ ${it['VALOR UNITÁRIO']}\n      Valor Total do Item: R$ ${it['VALOR TOTAL']}`\n    ).join('\\n')}\n  `;\n  \n  // Adicionar o documento e os metadados à lista de saída\n  documentosFormatados.push({\n    json: {\n      texto_para_embedding: textoDaNFCompleta,\n      metadata_chave_nf: idNota\n    }\n  });\n}\n\nreturn {\n    documentosFormatados\n};\n\n"
      },
